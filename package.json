{
  "name": "anan-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:backend",
    "dev:backend": "convex dev",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "dev:mobile": "cd mobile && npm start",
    "build:mobile": "cd mobile && npm run build",
    "dev:admin": "cd admin && npm run dev",
    "build:admin": "cd admin && npm run build",
    "predev": "convex dev --until-success && convex dashboard",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:column": "bun run scripts/run-column-tests.ts",
    "test:report": "node tests/focused-test.cjs $THREAD_ID --json 2>/dev/null | bun run scripts/generate-test-report.ts -o test-results-report.html",
    "chat:agent": "bun run scripts/curl-agent-chat.ts",
    "test:agent:run": "convex run agents/actions:testAgent '{\"message\": \"Hello, can you help me find apartments in Riyadh?\"}'",
    "test:once": "vitest run",
    "test:agent": "vitest run convex/agent.integration.test.ts --reporter=verbose",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:production:smoke": "bun run scripts/smoke-test-production.ts",
    "deploy:convex": "bun run scripts/deploy-convex-to-production.ts",
    "deploy:convex:and-test": "npm run deploy:convex && npm run typecheck && npm run test:once && npm run test:production:smoke"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.2",
    "@ai-sdk/provider-utils": "^4.0.14",
    "@better-auth/expo": "1.4.9",
    "@browserbasehq/convex-stagehand": "^0.0.2",
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/agent": "^0.3.2",
    "@convex-dev/better-auth": "0.10.10",
    "@convex-dev/rag": "^0.7.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.3.4",
    "@convex-dev/workpool": "^0.3.1",
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "@toon-format/toon": "^2.1.0",
    "ai": "^6.0.77",
    "better-auth": "1.4.9",
    "clsx": "^2.1.1",
    "convex": "^1.31.6",
    "convex-helpers": "^0.1.111",
    "lucide-react": "^0.563.0",
    "neutral-cost": "^0.2.2",
    "next-themes": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "convex-test": "^0.0.41",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^28.0.0",
    "npm-run-all2": "^5.0.0",
    "postcss": "^8.4.39",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vitest": "^4.0.18"
  }
}
