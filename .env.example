# Convex deployment
# .env.local = for local dev: use a dev Convex deployment and its URLs (run npx convex dev to get the deployment name).
# .env.production = for production: use prod Convex deployment and URLs; convex deploy can use these (e.g. env $(cat .env.production | xargs) npx convex deploy or set CONVEX_DEPLOYMENT in CI).
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Agent LLM (convex/agents/config.ts).
# Convex reads these from the dashboard only; set them in Convex Dashboard → Settings → Environment Variables (or npx convex env set KEY value).
# Using local model (e.g. LLM Studio at 127.0.0.1): run Convex locally so the backend can reach it: npx convex dev --local. Then set LLM_MODE=local and LLM_BASE_URL below. For Convex in the cloud, expose your LLM via a tunnel (ngrok, cloudflared) and set LLM_BASE_URL to the tunnel URL.
# LLM_MODE: local | openrouter | server. Default: openrouter if OPENROUTER_API_KEY set, else local.
LLM_MODE=local
# For local/server: base URL (include /v1 if your server uses it). Use http://127.0.0.1:1234/v1 only with convex dev --local.
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Model id for local/server (e.g. google/gemma-3-4b). OpenRouter uses OPENROUTER_MODEL.
LLM_MODEL=google/gemma-3-4b
# Optional. If set, sent as the API key when calling the custom LLM endpoint. Leave unset/empty for LLM Studio.
LLM_API_KEY=

# OpenRouter (when LLM_MODE=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Browser extraction model key for Stagehand (OpenAI-compatible key)
# Optional alternative name accepted by Stagehand helper
MODEL_API_KEY=
OPENAI_API_KEY=

# Browserbase / Stagehand (required for browseAndExtract)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional web search fallback
SERPER_API_KEY=

# Optional agent debug (development only)
# Set to true/1 to print structured agent logs and timings. For Convex: set in
# Convex dashboard (Settings → Environment Variables) for the dev deployment.
AGENT_DEBUG_LOGS=

# Optional WhatsApp channel integration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=
WHATSAPP_OTP_TEMPLATE_PARAM_COUNT=